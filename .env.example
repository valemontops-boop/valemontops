# ---------------------------------------------------------------
# Valemont OS environment. Copy to .env.local (never commit it).
# ---------------------------------------------------------------

# "demo" (synthetic data, permanent banner) or "live" (your Google Sheet). Required.
APP_MODE=demo
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
# Public URL of the app (used for the Google sign-in redirect).
APP_BASE_URL=http://localhost:3000
# Poll interval for near-real-time sync, 30 to 60 seconds.
SYNC_POLL_SECONDS=30

# --- Founders (LIVE) -------------------------------------------
# Exactly these two Google addresses may sign in. Put the real ones only in the host's env, never in code.
FOUNDER_THEO_EMAIL=theo@example.com
FOUNDER_PABLO_EMAIL=pablo@example.com
FOUNDER_THEO_TIMEZONE=Europe/Paris
FOUNDER_PABLO_TIMEZONE=Europe/Madrid

# --- Google sign-in (LIVE) -------------------------------------
# OAuth client (Web application). Redirect URI: <APP_BASE_URL>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Sheets (LIVE) --------------------------------------
# The id in the Sheet URL: https://docs.google.com/spreadsheets/d/<THIS>/edit
SHEETS_SPREADSHEET_ID=
# base64 of the service account JSON key: base64 -w0 key.json   (macOS: base64 -i key.json)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# Leave empty for Google. Tests/dev only: http://127.0.0.1:4010 (refused in production).
SHEETS_API_BASE_URL=

# --- Private founder spreadsheets (LIVE, Stage 1B) -------------
# One Sheet per founder, OWNED by that founder, shared only with the service account (Editor).
# Holds job applications and private tasks. Leave empty to disable those features.
PRIVATE_SHEET_ID_THEO=
PRIVATE_SHEET_ID_PABLO=

# --- Google Calendar / Drive (LIVE, Stage 1B) -------------------
# Calendar ids and the Drive folder id are entered in the app (Settings › Calendars / Workspace).
# Leave empty for Google. Tests only: the fake Google server URL.
GOOGLE_API_BASE_URL=

# --- DEMO ------------------------------------------------------
# memory (default) or fake-sheets (runs the real Sheets adapter against `npm run fake:sheets`)
DEMO_BACKEND=memory
FAKE_SHEETS_URL=http://127.0.0.1:4010
FAKE_SHEETS_SPREADSHEET_ID=demo-spreadsheet
# Required only for a production DEMO deployment (12+ characters).
DEMO_ACCESS_CODE=

# --- Wise (bank, read-only) — Money page. Never paste these in chat; set them in the host's env settings.
# Personal API token of the Wise BUSINESS account, read-only (Wise › Settings › API tokens).
WISE_API_TOKEN=
# Optional: business profile id (otherwise the first business profile of the token is used).
WISE_PROFILE_ID=
# Optional: base64 of a PEM RSA private key whose public key is uploaded in Wise (API tokens › Manage public keys).
# Needed only if Wise asks for strong authentication (SCA) to read statements; without it, import Wise CSV statements.
WISE_SCA_PRIVATE_KEY_BASE64=
# Base64 of Wise's webhook signing public key (production key from Wise's webhook docs). Webhook URL: {APP_BASE_URL}/api/webhooks/wise
WISE_WEBHOOK_PUBLIC_KEY_BASE64=
# Tests only: fake Wise server URL.
WISE_API_BASE_URL=

# --- Stripe (read-only) — Money page and MRR. Restricted key with Read on Balance, Balance transactions, Subscriptions, Customers.
STRIPE_API_KEY=
# Webhook signing secret (whsec_…) of the endpoint {APP_BASE_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Tests only.
STRIPE_API_BASE_URL=
