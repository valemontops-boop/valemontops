# ---------------------------------------------------------------
# Valemont OS environment. Copy to .env.local (never commit it).
# ---------------------------------------------------------------

# "demo" (synthetic data, permanent banner) or "live" (your Google Sheet). Required.
APP_MODE=demo
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
# Key of the in-app connector vault (D087): 32+ random bytes in base64 (openssl rand -base64 32). Keys pasted in
# Settings › Integrations are stored in the Sheet ONLY as AES-256-GCM ciphertext; this key never leaves the host.
# Unset: the key is derived from SESSION_SECRET (changing SESSION_SECRET then makes saved keys unreadable).
# Rotation: put the new key here and the old one in CONNECTORS_ENCRYPTION_KEY_PREVIOUS, then "Re-encrypt" in the app.
CONNECTORS_ENCRYPTION_KEY=
CONNECTORS_ENCRYPTION_KEY_PREVIOUS=
# Public URL of the app (used for the Google sign-in redirect). On Vercel it may stay unset: the deployment's
# address is used (VERCEL_PROJECT_PRODUCTION_URL in production, VERCEL_BRANCH_URL / VERCEL_URL in previews). D086.
APP_BASE_URL=http://localhost:3000
# Poll interval for near-real-time sync, 30 to 60 seconds.
SYNC_POLL_SECONDS=30

# --- Founders (LIVE) -------------------------------------------
# Exactly these two Google addresses may sign in. Put the real ones only in the host's env, never in code.
FOUNDER_THEO_EMAIL=theo@example.com
FOUNDER_PABLO_EMAIL=pablo@example.com
# Optional: Europe/Paris and Europe/Madrid when unset.
FOUNDER_THEO_TIMEZONE=Europe/Paris
FOUNDER_PABLO_TIMEZONE=Europe/Madrid
# D090: the address every client email leaves from (both founders; each keeps their own signature). Default of the
# Workspace setting "email_sender_address" (Settings › Workspace overrides it). Gmail must be connected WITH this
# mailbox: the app refuses a gmail.send grant from any other address. Example only: put your real address in Vercel.
EMAIL_SENDER_ADDRESS=contact@example.com

# --- Google sign-in (LIVE) -------------------------------------
# OAuth client (Web application). Redirect URI: <APP_BASE_URL>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Sheets (LIVE) --------------------------------------
# The id in the Sheet URL: https://docs.google.com/spreadsheets/d/<THIS>/edit
SHEETS_SPREADSHEET_ID=
# The service account JSON key: the file content pasted as-is, or its base64 (base64 -w0 key.json; macOS: base64 -i key.json)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# Leave empty for Google. Tests/dev only: http://127.0.0.1:4010 (refused in production).
SHEETS_API_BASE_URL=

# --- Private founder spreadsheets (LIVE, Stage 1B) -------------
# One Sheet per founder, OWNED by that founder, shared only with the service account (Editor).
# Holds job applications and private tasks. Leave empty to disable those features.
PRIVATE_SHEET_ID_THEO=
PRIVATE_SHEET_ID_PABLO=

# --- Google Calendar / Drive (LIVE, Stage 1B) -------------------
# Calendar ids and the Drive folder id are entered in the app (Settings › Calendars / Workspace).
# Leave empty for Google. Tests only: the fake Google server URL.
GOOGLE_API_BASE_URL=

# --- DEMO ------------------------------------------------------
# memory (default) or fake-sheets (runs the real Sheets adapter against `npm run fake:sheets`)
DEMO_BACKEND=memory
FAKE_SHEETS_URL=http://127.0.0.1:4010
FAKE_SHEETS_SPREADSHEET_ID=demo-spreadsheet
# Required only for a production DEMO deployment (12+ characters).
DEMO_ACCESS_CODE=

# --- Wise (bank, read-only) — Money page. Never paste these in chat; set them in the host's env settings.
# Personal API token of the Wise BUSINESS account, read-only (Wise › Settings › API tokens).
WISE_API_TOKEN=
# Optional: business profile id (otherwise the first business profile of the token is used).
WISE_PROFILE_ID=
# Optional: base64 of a PEM RSA private key whose public key is uploaded in Wise (API tokens › Manage public keys).
# Needed only if Wise asks for strong authentication (SCA) to read statements; without it, import Wise CSV statements.
WISE_SCA_PRIVATE_KEY_BASE64=
# Base64 of Wise's webhook signing public key (production key from Wise's webhook docs). Webhook URL: {APP_BASE_URL}/api/webhooks/wise
WISE_WEBHOOK_PUBLIC_KEY_BASE64=
# Tests only: fake Wise server URL.
WISE_API_BASE_URL=

# --- Stripe (read-only) — Money page and MRR. Restricted key with Read on Balance, Balance transactions, Subscriptions, Customers.
STRIPE_API_KEY=
# Webhook signing secret (whsec_…) of the endpoint {APP_BASE_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Tests only.
STRIPE_API_BASE_URL=

# --- My tracker (each founder's personal performance app) — Settings › My tracker, docs/TRACKER.md.
# Never paste these in chat; set them in the host's env settings. LIVE only: DEMO never sends anything.
# PUSH: every new activity of the founder is POSTed (JSON, signed X-Valemont-Signature: sha256=HMAC(secret, body)).
# https:// only. Secret: 16+ characters (generate with: openssl rand -hex 32).
TRACKER_WEBHOOK_URL_THEO=
TRACKER_WEBHOOK_SECRET_THEO=
TRACKER_WEBHOOK_URL_PABLO=
TRACKER_WEBHOOK_SECRET_PABLO=
# Optional: also push a day summary when the founder saves the daily review (1 = on).
TRACKER_DAILY_SUMMARY_THEO=
TRACKER_DAILY_SUMMARY_PABLO=
# PULL: GET {APP_BASE_URL}/api/tracker/feed?from=YYYY-MM-DD&to=YYYY-MM-DD with "Authorization: Bearer <token>" (24+ characters).
TRACKER_FEED_TOKEN_THEO=
TRACKER_FEED_TOKEN_PABLO=

# --- "To reply" inbox (docs/INBOX.md). Never paste these in chat; set them in the host's env settings.
# Shared secret of the relay (Make, Zapier, n8n) posting to {APP_BASE_URL}/api/inbox/webhook with
# X-Valemont-Signature: sha256=HMAC-SHA256(secret, raw body). Empty = the webhook refuses every call.
INBOX_WEBHOOK_SECRET=
# Meta app (Instagram webhook {APP_BASE_URL}/api/inbox/meta): App secret (X-Hub-Signature-256) and the verify token you choose.
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Instagram statistics (read-only, Content Studio, D079) — docs/INTEGRATIONS.md. LIVE only; empty = manual entry.
# One account: Instagram professional account id + token (System User token preferred: it does not expire).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Our social account key for it: ig-valemont (default) or ig-thirty.
INSTAGRAM_ACCOUNT_KEY=
# Only for a 60-day Instagram Login token (YYYY-MM-DD): days left shown, task created 14 days before.
INSTAGRAM_TOKEN_EXPIRES_AT=
# Several accounts instead: [{"account":"ig-valemont","ig_user_id":"…","token":"…","expires_at":""},{"account":"ig-thirty",…}]
INSTAGRAM_ACCOUNTS_JSON=
# https://graph.facebook.com/v21.0 (default, Facebook Login) or https://graph.instagram.com/v21.0 (Instagram Login); tests: fake URL.
INSTAGRAM_API_BASE_URL=
# Snapshot job POST {APP_BASE_URL}/api/jobs/snapshot every 6 hours: HMAC secret (X-Valemont-Timestamp + X-Valemont-Signature)
# and/or a bearer token (24+ characters) for schedulers that cannot sign. Generate with: openssl rand -hex 32
SNAPSHOT_JOB_SECRET=
SNAPSHOT_JOB_TOKEN=

# --- Website forms (FR/ES sites, Stage 4A, D083) — docs/INTEGRATIONS.md "Website forms webhook". Never paste it in chat.
# Shared with the site's SERVER-SIDE form handler (Netlify function, Worker…), which signs POST {APP_BASE_URL}/api/webhooks/website:
# X-Valemont-Timestamp: <unix s> + X-Valemont-Signature: sha256=HMAC-SHA256(secret, "<timestamp>.<raw body>"). 32+ characters
# (openssl rand -hex 32). Empty = the endpoint refuses every call.
WEBSITE_WEBHOOK_SECRET=

# --- Backups, jobs and logs (Stage 4B, D084) — docs/DEPLOYMENT.md › Backups. LIVE only.
# Drive folder id that receives the daily copy of the Sheet ("Valemont OS backup YYYY-MM-DD"). Share it with the
# service account as Editor. On a personal Google account it must be in a Shared Drive (a service account owns no
# storage); otherwise use the founder-owned Apps Script copy described in DEPLOYMENT.md. Empty = no daily copy.
# Optional: Drive folder shared with the service account, used when Settings › Workspace has no value yet.
DRIVE_FOLDER_ID=
# Optional one-time setup values: SETTING_<KEY>=value fills a Settings value while it is missing or empty
# (e.g. SETTING_CALENDLY_URL_THEO, SETTING_DECK_URL_FR). Values edited later in Settings always win.
BACKUP_DRIVE_FOLDER_ID=
# Days of daily copies kept (1–365, default 30). Older copies made by the app are moved to the Drive trash.
BACKUP_RETENTION_DAYS=30
# External scheduler for POST/GET {APP_BASE_URL}/api/jobs/backup: HMAC secret (X-Valemont-Timestamp + X-Valemont-Signature)
# and/or a bearer token (24+ characters). Without one, the first visit of the day starts the backup.
BACKUP_JOB_SECRET=
BACKUP_JOB_TOKEN=
# Vercel Cron only: Vercel sends "Authorization: Bearer <CRON_SECRET>" to /api/jobs/backup and /api/jobs/snapshot.
CRON_SECRET=
# Structured JSON logs: debug | info (default) | warn | error | silent. Secrets, emails and phones are always redacted.
LOG_LEVEL=info
