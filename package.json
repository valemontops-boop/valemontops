{
  "name": "valemont-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "test:live": "tsx --env-file-if-exists=.env.live-test tests/live/run-live.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "setup:sheets": "tsx --env-file-if-exists=.env.local scripts/setup-sheets.ts",
    "doctor:sheets": "tsx --env-file-if-exists=.env.local scripts/doctor-sheets.ts",
    "restore:sheets": "tsx --env-file-if-exists=.env.local scripts/restore-sheets.ts",
    "fake:sheets": "tsx scripts/fake-sheets.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "geist": "^1.9.2",
    "google-auth-library": "^11.3.3",
    "jose": "^6.2.16",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
